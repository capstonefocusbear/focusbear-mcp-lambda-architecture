# Copy outside version control, e.g. /tmp/focusbear-mcp.env; pass MCP_ENV_FILE.
# The backend also reads .env for its unrelated development settings.
OAUTH_ISSUER=https://YOUR-DEVELOPMENT-TENANT.auth0.com/
OAUTH_JWKS_URL=https://YOUR-DEVELOPMENT-TENANT.auth0.com/.well-known/jwks.json
MCP_RESOURCE_URL=http://localhost:5039/mcp
MCP_ALLOWED_CLIENT_IDS=YOUR_APPROVED_DEVELOPMENT_CLIENT_ID
MCP_TOKEN_PROFILE=auth0
MCP_MAX_TOKEN_LIFETIME_SECONDS=900
MCP_AUTH0_ENABLED=true
MCP_ALLOW_LOCAL_HTTP=true
# Optional paid LocalStack entitlement, only if your chosen emulator features require it.
LOCALSTACK_AUTH_TOKEN=
# Smoke uses MCP_ACCESS_TOKEN from the shell (never save tokens in this file).
