# Stage 1: Build
FROM node:22 AS builder
WORKDIR /app/backend
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build

# Stage 2: Server
FROM node:22-slim
WORKDIR /app/backend
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
# Copy both source and compiled code
COPY --from=builder /app/backend/dist ./dist

EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 CMD curl -f http://localhost:4000/healthcheck || exit 1
CMD ["npm", "run", "start:no-migration"]