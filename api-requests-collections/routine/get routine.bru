meta {
  name: get routine
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/activity-library/routine-suggestions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "routine_duration": 10,
    "user_goals": [
      "Build healthy habits",
      "Stay focused at work"
    ]
  }
}
