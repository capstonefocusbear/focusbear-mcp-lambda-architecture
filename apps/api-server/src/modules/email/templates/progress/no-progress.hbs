<mj-text color="#333333">
  <p>{{headerSubtitle}}</p>
  <p>{{haventSeenYouText}}<br/>
  {{journeyPausesText}}</p>
</mj-text>

{{> metric-card title=goodNewsTitle content=goodNewsContent}}

{{> metric-card title=tinyActionTitle content=(concat
  "<ul>"
  "<li>" openFocusBearText "</li>"
  "<li>" completeOneHabitText "</li>"
  "</ul>"
  "<p>" smallStepForwardText "</p>"
)}}

{{> cta-button href=dashboardUrl text=getBackOnTrackText}}

{{#if announcements.length}}
<mj-divider border-color="#eee" />

<mj-text color="#333333">
  <p>{{announcementsTitle}}</p>
</mj-text>

{{#each announcements}}
<mj-text css-class="metric-card" color="#333333">
  <div class="metric-title">{{heading}}</div>
  <p>{{details}}</p>
  {{#if details_url}}
    <p>
      <a href="{{details_url}}" style="color:#FF6B35;">
        {{../announcementCtaText}}
      </a>
    </p>
  {{/if}}
</mj-text>
{{/each}}
{{/if}}

<mj-text color="#333333">
  <p>{{footerText}}<br/>
  {{weBelieveInYouText}}</p>
  <p><strong>{{focusBearTeamText}}</strong></p>
</mj-text>

<mj-divider border-color="#eee" />

<mj-text align="center" color="#999999" font-size="11px">
  <p>{{wantToChangeFrequencyText}}<br/>
  <a href="{{manageEmailPreferencesLink}}" style="color: #FF6B35;">{{managePreferencesText}}</a></p>
</mj-text>
