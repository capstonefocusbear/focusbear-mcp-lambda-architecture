{
  "moduleFileExtensions": ["js", "json", "ts"],
  "setupFilesAfterEnv": [
    "jest-extended/all"
  ],
  "rootDir": "../../../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/fastify-content-types(|/.*)$": "<rootDir>/libs/fastify-content-types/src/$1",
    "^@app/crypto(|/.*)$": "<rootDir>/libs/crypto/src/$1",
    "^@app/dynamic-module(|/.*)$": "<rootDir>/libs/dynamic-module/src/$1",
    "^@app/auth0(|/.*)$": "<rootDir>/libs/auth0/src/$1",
    "^@app/pusher(|/.*)$": "<rootDir>/libs/pusher/src/$1",
    "^@app/pusher-beams(|/.*)$": "<rootDir>/libs/pusher-beams/src/$1",
    "^@app/revenue-cat(|/.*)$": "<rootDir>/libs/revenue-cat/src/$1",
    "^@app/send-grid(|/.*)$": "<rootDir>/libs/send-grid/src/$1",
    "^@app/jwt(|/.*)$": "<rootDir>/libs/jwt/src/$1",
    "^@app/stripe(|/.*)$": "<rootDir>/libs/stripe/src/$1",
    "^@app/r2(|/.*)$": "<rootDir>/libs/r2/src/$1",
    "^@app/openai(|/.*)$": "<rootDir>/libs/openai/src/$1",
    "^@app/brevo(|/.*)$": "<rootDir>/libs/brevo/src/$1"
  }
}
