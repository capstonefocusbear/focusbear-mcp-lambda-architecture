# Version pins are reproducible inputs; release handoff records the final ECR sha256 digest.
FROM node:22.23.2-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY apps/mcp-server ./apps/mcp-server
COPY libs/jwt ./libs/jwt
COPY nest-cli.json tsconfig.json tsconfig.build.json ./
RUN npm run mcp:build && test -f dist-mcp/apps/mcp-server/apps/mcp-server/src/main.js
RUN npm prune --omit=dev --ignore-scripts

FROM node:22.23.2-bookworm-slim
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 /lambda-adapter /opt/extensions/lambda-adapter
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist-mcp ./dist-mcp
COPY --from=builder /app/package.json ./package.json
ENV NODE_ENV=production MCP_BIND_HOST=0.0.0.0 MCP_PORT=5039 AWS_LWA_PORT=5039 \
    AWS_LWA_READINESS_CHECK_PATH=/.well-known/oauth-protected-resource AWS_LWA_INVOKE_MODE=buffered
EXPOSE 5039
USER node
CMD ["node", "dist-mcp/apps/mcp-server/apps/mcp-server/src/main.js"]
