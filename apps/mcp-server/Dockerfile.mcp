FROM node:22-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Build specifically for the MCP
RUN npx nest build mcp-server 

FROM node:22-slim
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
# Copy the entire dist folder exactly as Nest built it (keeping apps and libs intact)
COPY --from=builder /app/dist-mcp ./dist-mcp
COPY package.json .
ENV MCP_BIND_HOST=0.0.0.0
EXPOSE 5039

# Run the specific main.js file for the MCP server
CMD ["node", "dist-mcp/apps/mcp-server/main.js"]
