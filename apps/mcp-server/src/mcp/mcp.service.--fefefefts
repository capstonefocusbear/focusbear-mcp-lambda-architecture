import { Injectable, Logger } from '@nestjs/common';

@Injectable()
export class McpService {
  private readonly logger = new Logger(McpService.name);

  async handleStreamRequest(body: any, userJwt: string, responseStream: any) {
    try {
      // Example Step 1: Internal Handshake (Calling your main api-server)
      // const internalData = await this.fetchDataFromApiServer(userJwt);

      responseStream.write(`data: ${JSON.stringify({ status: 'Data retrieved, consulting AI...' })}\n\n`);

      // Example Step 2: OpenAI Streaming
      // const aiStream = await openai.chat.completions.create({ stream: true, ... });

      // Simulate an AI text stream for now
      const mockWords = ['Hello', 'from', 'Focus', 'Bear', 'AI!'];
      for (const word of mockWords) {
        // Await a tiny delay to simulate network latency
        await new Promise((resolve) => setTimeout(resolve, 300));

        // Write chunks directly to the open SSE stream
        responseStream.write(`data: ${JSON.stringify({ text: word })}\n\n`);
      }
    } catch (error) {
      this.logger.error('Error processing stream', error);
      responseStream.write(`data: ${JSON.stringify({ error: 'Failed to process AI task' })}\n\n`);
    }
  }
}
