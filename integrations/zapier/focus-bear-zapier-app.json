{
  "platformVersion": "15.0.0",
  "version": "1.0.0",
  "name": "Focus Bear",
  "description": "Connect Focus Bear to thousands of apps. Track habits, routines, and focus sessions.",
  "authentication": {
    "type": "oauth2",
    "oauth2Config": {
      "authorizeUrl": "https://{{AUTH0_DOMAIN}}/authorize",
      "getAccessToken": {
        "url": "https://{{AUTH0_DOMAIN}}/oauth/token",
        "method": "POST",
        "body": {
          "client_id": "{{CLIENT_ID}}",
          "client_secret": "{{CLIENT_SECRET}}",
          "code": "{{bundle.inputData.code}}",
          "grant_type": "authorization_code",
          "redirect_uri": "{{bundle.inputData.redirect_uri}}"
        }
      },
      "refreshAccessToken": {
        "url": "https://{{AUTH0_DOMAIN}}/oauth/token",
        "method": "POST",
        "body": {
          "client_id": "{{CLIENT_ID}}",
          "client_secret": "{{CLIENT_SECRET}}",
          "refresh_token": "{{bundle.authData.refresh_token}}",
          "grant_type": "refresh_token"
        }
      },
      "scope": "openid profile email offline_access",
      "autoRefresh": true
    },
    "test": {
      "url": "{{API_BASE_URL}}/external/v1/me"
    },
    "connectionLabel": "{{bundle.inputData.email}}"
  },
  "triggers": {
    "habit_completed": {
      "key": "habit_completed",
      "noun": "Habit",
      "display": {
        "label": "Habit Completed",
        "description": "Triggers when a habit is completed.",
        "important": true
      },
      "operation": {
        "type": "hook",
        "performSubscribe": {
          "url": "{{API_BASE_URL}}/webhooks/subscriptions",
          "method": "POST",
          "body": {
            "name": "Zapier - Habit Completed",
            "url": "{{bundle.targetUrl}}",
            "event_types": ["habit.completed"]
          }
        },
        "performUnsubscribe": {
          "url": "{{API_BASE_URL}}/webhooks/subscriptions/{{bundle.subscribeData.id}}",
          "method": "DELETE"
        },
        "perform": {
          "url": "{{API_BASE_URL}}/external/v1/webhooks/sample/habit.completed"
        },
        "sample": {
          "event_type": "habit.completed",
          "timestamp": "2024-01-15T10:30:00Z",
          "user_id": "user_123",
          "data": {
            "habit_name": "Morning Meditation",
            "routine_name": "morning",
            "duration_seconds": 600,
            "completed_at": "2024-01-15T10:30:00Z"
          }
        },
        "outputFields": [
          {"key": "event_type", "label": "Event Type"},
          {"key": "timestamp", "label": "Timestamp"},
          {"key": "user_id", "label": "User ID"},
          {"key": "data__habit_name", "label": "Habit Name"},
          {"key": "data__routine_name", "label": "Routine Name"},
          {"key": "data__duration_seconds", "label": "Duration (seconds)"},
          {"key": "data__completed_at", "label": "Completed At"}
        ]
      }
    },
    "routine_completed": {
      "key": "routine_completed",
      "noun": "Routine",
      "display": {
        "label": "Routine Completed",
        "description": "Triggers when a routine (morning/evening) is completed.",
        "important": true
      },
      "operation": {
        "type": "hook",
        "performSubscribe": {
          "url": "{{API_BASE_URL}}/webhooks/subscriptions",
          "method": "POST",
          "body": {
            "name": "Zapier - Routine Completed",
            "url": "{{bundle.targetUrl}}",
            "event_types": ["routine.completed"]
          }
        },
        "performUnsubscribe": {
          "url": "{{API_BASE_URL}}/webhooks/subscriptions/{{bundle.subscribeData.id}}",
          "method": "DELETE"
        },
        "perform": {
          "url": "{{API_BASE_URL}}/external/v1/webhooks/sample/routine.completed"
        },
        "sample": {
          "event_type": "routine.completed",
          "timestamp": "2024-01-15T07:30:00Z",
          "user_id": "user_123",
          "data": {
            "routine_name": "morning",
            "completed_habits_count": 5,
            "completed_at": "2024-01-15T07:30:00Z"
          }
        },
        "outputFields": [
          {"key": "event_type", "label": "Event Type"},
          {"key": "timestamp", "label": "Timestamp"},
          {"key": "user_id", "label": "User ID"},
          {"key": "data__routine_name", "label": "Routine Name"},
          {"key": "data__completed_habits_count", "label": "Completed Habits Count"},
          {"key": "data__completed_at", "label": "Completed At"}
        ]
      }
    },
    "focus_session_started": {
      "key": "focus_session_started",
      "noun": "Focus Session",
      "display": {
        "label": "Focus Session Started",
