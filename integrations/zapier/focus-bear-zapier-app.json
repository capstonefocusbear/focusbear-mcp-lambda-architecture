          "url": "{{API_BASE_URL}}/external/v1/webhooks/sample/focus_session.started"
        },
        "sample": {
          "event_type": "focus_session.started",
          "timestamp": "2024-01-15T09:00:00Z",
          "user_id": "user_123",
          "data": {
            "focus_mode_name": "Deep Work",
            "intention": "Complete project report",
            "scheduled_finish_time": "2024-01-15T11:00:00Z",
            "started_at": "2024-01-15T09:00:00Z"
