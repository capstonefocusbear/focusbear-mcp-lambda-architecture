  },
  "creates": {
    "start_focus_session": {
      "key": "start_focus_session",
      "noun": "Focus Session",
      "display": {
        "label": "Start Focus Session",
        "description": "Starts a new focus session with the specified focus mode."
      },
      "operation": {
        "perform": {
          "url": "{{API_BASE_URL}}/external/v1/focus-session/start",
          "method": "POST",
          "body": {
            "focus_mode_name": "{{bundle.inputData.focus_mode_name}}",
            "duration_minutes": "{{bundle.inputData.duration_minutes}}",
            "intention": "{{bundle.inputData.intention}}"
          }
        },
        "inputFields": [
          {
            "key": "focus_mode_name",
            "label": "Focus Mode Name",
            "type": "string",
            "required": true,
            "helpText": "The name of the focus mode to start (e.g., 'Deep Work', 'Creative Time')"
          },
          {
            "key": "duration_minutes",
            "label": "Duration (minutes)",
            "type": "integer",
            "required": false,
            "helpText": "How long the focus session should last in minutes"
          },
          {
            "key": "intention",
            "label": "Intention",
            "type": "string",
            "required": false,
            "helpText": "What you plan to accomplish during this focus session"
          }
        ],
        "sample": {
          "success": true,
          "message": "Focus session started",
          "focus_mode_id": "fm_123",
          "focus_mode_name": "Deep Work",
          "started_at": "2024-01-15T09:00:00Z"
        }
      }
    },
    "complete_habit": {
      "key": "complete_habit",
      "noun": "Habit",
      "display": {
        "label": "Complete Habit",
        "description": "Marks a habit as completed within a routine."
      },
      "operation": {
        "perform": {
          "url": "{{API_BASE_URL}}/external/v1/habit/complete",
          "method": "POST",
          "body": {
            "habit_name": "{{bundle.inputData.habit_name}}",
            "routine_name": "{{bundle.inputData.routine_name}}",
            "duration_seconds": "{{bundle.inputData.duration_seconds}}"
          }
        },
        "inputFields": [
          {
            "key": "habit_name",
            "label": "Habit Name",
            "type": "string",
            "required": true,
            "helpText": "The name of the habit to complete"
          },
          {
            "key": "routine_name",
            "label": "Routine Name",
            "type": "string",
            "required": false,
            "choices": ["morning", "evening", "break"],
            "helpText": "Optional routine name to disambiguate the habit"
          },
          {
            "key": "duration_seconds",
            "label": "Duration (seconds)",
            "type": "integer",
            "required": false,
            "helpText": "How long the habit took to complete in seconds"
          }
        ],
        "sample": {
          "success": true,
          "message": "Habit completed",
          "habit_name": "Morning Meditation",
          "routine_name": "morning",
          "completed_at": "2024-01-15T07:15:00Z"
        }
      }
    }
  },
  "searchOrCreates": {},
  "searches": {},
  "resources": {}
}
