{
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-server/src",
  "monorepo": true,
  "root": "apps/api-server",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "apps/api-server/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "dtoFileNameSuffix": [
            ".dto.ts",
            ".entity.ts",
            ".model.ts"
          ]
        }
      }
    ]
  },
  "projects": {
    "api-server": {
      "type": "application",
      "root": "apps/api-server",
      "entryFile": "main",
      "sourceRoot": "apps/api-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-server/tsconfig.app.json"
      }
    },
    "fastify-content-types": {
      "type": "library",
      "root": "libs/fastify-content-types",
      "entryFile": "index",
      "sourceRoot": "libs/fastify-content-types/src",
      "compilerOptions": {
        "tsConfigPath": "libs/fastify-content-types/tsconfig.lib.json"
      }
    },
    "crypto": {
      "type": "library",
      "root": "libs/crypto",
      "entryFile": "index",
      "sourceRoot": "libs/crypto/src",
      "compilerOptions": {
        "tsConfigPath": "libs/crypto/tsconfig.lib.json"
      }
    },
    "dynamic-module": {
      "type": "library",
      "root": "libs/dynamic-module",
      "entryFile": "index",
      "sourceRoot": "libs/dynamic-module/src",
      "compilerOptions": {
        "tsConfigPath": "libs/dynamic-module/tsconfig.lib.json"
      }
    },
    "auth0": {
      "type": "library",
      "root": "libs/auth0",
      "entryFile": "index",
      "sourceRoot": "libs/auth0/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth0/tsconfig.lib.json"
      }
    },
    "pusher": {
      "type": "library",
      "root": "libs/pusher",
      "entryFile": "index",
      "sourceRoot": "libs/pusher/src",
      "compilerOptions": {
        "tsConfigPath": "libs/pusher/tsconfig.lib.json"
      }
    },
    "revenue-cat": {
      "type": "library",
      "root": "libs/revenue-cat",
      "entryFile": "index",
      "sourceRoot": "libs/revenue-cat/src",
      "compilerOptions": {
        "tsConfigPath": "libs/revenue-cat/tsconfig.lib.json"
      }
    },
    "stripe": {
      "type": "library",
      "root": "libs/stripe",
      "entryFile": "index",
      "sourceRoot": "libs/stripe/src",
      "compilerOptions": {
        "tsConfigPath": "libs/stripe/tsconfig.lib.json"
      }
    }
  }
}