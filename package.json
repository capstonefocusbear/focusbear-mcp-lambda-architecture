{
  "name": "eyst-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build api-server && npm run build:cron && npm run build:cron-support && npm run build:assets",
    "build:cron": "tsc -p tsconfig.cron.json",
    "build:cron-support": "mkdir -p dist/cron-jobs && cp cron-jobs/register-dist-paths.js dist/cron-jobs/register-dist-paths.js",
    "build:assets": "mkdir -p dist/apps/api-server/shared && cp -R apps/api-server/src/shared/i18n dist/apps/api-server/shared/i18n && mkdir -p dist/apps/api-server/src/shared && cp -R apps/api-server/src/shared/i18n dist/apps/api-server/src/shared/i18n && mkdir -p dist/apps/api-server/modules/email && cp -R apps/api-server/src/modules/email/templates dist/apps/api-server/modules/email/templates && mkdir -p dist/apps/api-server/src/modules/email && cp -R apps/api-server/src/modules/email/templates dist/apps/api-server/src/modules/email/templates && mkdir -p dist/apps/api-server/test && cp -R apps/api-server/test/prompt-testing dist/apps/api-server/test/prompt-testing",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "prestart": "npm run migration:up",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "sh start-server-with-memory-limit.sh",
    "start:no-migration": "sh start-server-with-memory-limit.sh",
    "cron:routine-push-notifications": "ts-node -r tsconfig-paths/register ./cron-jobs/routine-notifications-cron-job/cron-job.ts",
    "cron:calendar-event-notifications": "ts-node -r tsconfig-paths/register ./cron-jobs/calendar-cron-job/notification-cron-job.ts",
    "cron:user-daily-stats": "ts-node -r tsconfig-paths/register ./cron-jobs/user-stats-cron-job/user-stats-cron-job.ts",
    "cron:events": "ts-node -r tsconfig-paths/register ./cron-jobs/calendar-cron-job/event-cron-job.ts",
    "cron:expired-team-members": "ts-node -r tsconfig-paths/register ./cron-jobs/expired-team-members/cron-job.ts",
    "cron:expired-unlock-requests": "ts-node -r tsconfig-paths/register ./cron-jobs/expired-accountability-buddy/expired-unlock-requests-cron-job.ts",
    "cron:expired-invitations": "ts-node -r tsconfig-paths/register ./cron-jobs/expired-accountability-buddy/expired-invitations-cron-job.ts",
    "cron:pusher": "ts-node -r tsconfig-paths/register ./cron-jobs/pusher-cron-job/pusher-cron-job.ts",
    "cron:data-sync-notification": "ts-node -r tsconfig-paths/register ./cron-jobs/data-sync-notification-cron-job/cron-job.ts",
    "cron:daily": "node -r ./dist/cron-jobs/register-dist-paths.js dist/cron-jobs/progress-emails-cron-job/daily-progress-emails-cron-job.js",
    "cron:weekly": "node -r ./dist/cron-jobs/register-dist-paths.js dist/cron-jobs/progress-emails-cron-job/weekly-progress-emails-cron-job.js",
    "cron:monthly": "node -r ./dist/cron-jobs/register-dist-paths.js dist/cron-jobs/progress-emails-cron-job/monthly-progress-emails-cron-job.js",
    "cron:no-progress": "node -r ./dist/cron-jobs/register-dist-paths.js dist/cron-jobs/progress-emails-cron-job/no-progress-emails-cron-job.js",
    "cron:activity-template-embedding-sync": "ts-node -r tsconfig-paths/register ./cron-jobs/activity-template-embedding-sync.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-server/test/jest-e2e.json",
    "test:url-prompts": "npx promptfoo eval -c ./apps/api-server/test/prompt-testing/url-safety/config.yaml --no-cache",
    "test:app-prompts": "npx promptfoo eval -c ./apps/api-server/test/prompt-testing/app-safety/config.yaml --no-cache",
    "test:prompts:watch": "for f in ./apps/api-server/test/prompt-testing/*/config.yaml; do promptfoo eval --watch -c --no-cache \"$f\"; done",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d apps/api-server/ormconfig.ts",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:up": "npm run typeorm -- migration:run",
    "migration:down": "npm run typeorm -- migration:revert",
    "data:migration:run": "ts-node apps/api-server/data_migrations/1710000000000-DataTransferWithEncryption.ts",
    "render:deploy": "node ./.github/workflows/deploy.js",
    "seed": "ts-node apps/api-server/src/seeding/seed.ts",
    "smoke-test": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.931.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
