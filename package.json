{
  "name": "eyst-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "prestart": "npm run migration:up",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node dist/apps/api-server/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-server/test/jest-e2e.json",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js --config apps/api-server/ormconfig.ts",
    "migration:create": "npm run typeorm -- migration:create -n ",
    "migration:up": "npm run typeorm -- migration:run",
    "migration:down": "npm run typeorm -- migration:revert",
    "render:deploy": "node ./.github/workflows/deploy.js"
  },
  "dependencies": {
    "@fastify/swagger": "^6.0.1",
    "@nestjs/common": "^8.0.0",
    "@nestjs/config": "^1.0.1",
    "@nestjs/core": "^8.0.0",
    "@nestjs/mapped-types": "^1.0.0",
    "@nestjs/platform-fastify": "^8.0.5",
    "@nestjs/swagger": "^5.2.1",
    "@nestjs/typeorm": "^8.0.2",
    "@nestjs/websockets": "^8.0.6",
    "api": "^4.5.1",
    "auth0": "^2.40.0",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "fastify-cors": "^6.0.2",
    "fastify-helmet": "^5.3.2",
    "fastify-swagger": "^5.2.0",
    "jsonwebtoken": "^8.5.1",
    "jwks-rsa": "^2.1.2",
    "pg": "^8.7.1",
    "pusher": "^5.1.0-beta",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "typeorm": "^0.2.36",
    "typeorm-encrypted": "^0.7.0"
  },
  "devDependencies": {
    "@commitlint/config-angular": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@nestjs/cli": "^8.1.2",
    "@nestjs/schematics": "^8.0.0",
    "@nestjs/testing": "^8.0.0",
    "@types/auth0": "^2.34.19",
    "@types/jest": "^27.0.2",
    "@types/node": "^16.0.0",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^4.29.0",
    "@typescript-eslint/parser": "^4.29.0",
    "commitlint": "^13.1.0",
    "eslint": "^7.30.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^1.0.0-rc.13",
    "jest": "27.0.6",
    "jest-extended": "^1.0.0",
    "lint-staged": "^11.1.2",
    "pre-commit": "^1.2.2",
    "prettier": "^2.3.2",
    "supertest": "^6.1.3",
    "ts-jest": "^27.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5",
    "webpack": "^5.58.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "{apps,libs,test}/**/*.ts": [
      "npm audit --production",
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ],
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.(t|j)s",
      "**/*.quard.(t|j)s",
      "**/*.middleware.(t|j)s"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/fastify-content-types(|/.*)$": "<rootDir>/libs/fastify-content-types/src/$1",
      "^@app/crypto(|/.*)$": "<rootDir>/libs/crypto/src/$1",
      "^@app/dynamic-module(|/.*)$": "<rootDir>/libs/dynamic-module/src/$1",
      "^@app/auth0(|/.*)$": "<rootDir>/libs/auth0/src/$1",
      "^@app/pusher(|/.*)$": "<rootDir>/libs/pusher/src/$1",
      "^@app/revenue-cat(|/.*)$": "<rootDir>/libs/revenue-cat/src/$1"
    }
  }
}