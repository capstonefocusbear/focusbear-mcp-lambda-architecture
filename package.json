    },
    "qs": "^6.14.1",
    "ws": "^8.17.1",
    "test-exclude": "7.0.1",
    "cross-spawn": "7.0.6",
    "undici": "6.23.0",
    "brace-expansion": "^2.0.2",
    "form-data": "^4.0.4",
    "tmp": "0.2.4",
    "glob": {
      ".": "11.1.0",
      "minimatch": {
        "brace-expansion": "^5.0.2"
      }
    },
    "@modelcontextprotocol/sdk": "^1.24.1",
    "jws": "4.0.1",
    "jsdiff": "^8.03",
    "hono": "^4.11.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "{apps,libs,test}/**/*.ts": [
      "npm audit --production --audit-level=critical",
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ],
    "setupFiles": [
      "<rootDir>/apps/api-server/test/mocks/index.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.(t|j)s",
      "**/*.guard.(t|j)s",
      "**/*.strategy.(t|j)s",
      "**/*.middleware.(t|j)s"
    ],
    "coverageThreshold": {
      "global": {
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/",
      "<rootDir>/cron-jobs"
    ],
    "moduleNameMapper": {
      "^@app/fastify-content-types(|/.*)$": "<rootDir>/libs/fastify-content-types/src/$1",
      "^@app/crypto(|/.*)$": "<rootDir>/libs/crypto/src/$1",
      "^@app/dynamic-module(|/.*)$": "<rootDir>/libs/dynamic-module/src/$1",
      "^@app/auth0(|/.*)$": "<rootDir>/libs/auth0/src/$1",
      "^@app/pusher(|/.*)$": "<rootDir>/libs/pusher/src/$1",
      "^@app/pusher-beams(|/.*)$": "<rootDir>/libs/pusher-beams/src/$1",
      "^@app/revenue-cat(|/.*)$": "<rootDir>/libs/revenue-cat/src/$1",
      "^@app/send-grid(|/.*)$": "<rootDir>/libs/send-grid/src/$1",
      "^@app/jwt(|/.*)$": "<rootDir>/libs/jwt/src/$1",
      "^@app/stripe(|/.*)$": "<rootDir>/libs/stripe/src/$1",
      "^@app/r2(|/.*)$": "<rootDir>/libs/r2/src/$1",
      "^@app/openai(|/.*)$": "<rootDir>/libs/openai/src/$1",
      "^@app/brevo(|/.*)$": "<rootDir>/libs/brevo/src/$1",
      "^@app/observability(|/.*)$": "<rootDir>/libs/observability/src/$1",
      "^@app/gemini(|/.*)$": "<rootDir>/libs/gemini/src/$1",
      "^@api-server(|/.*)$": "<rootDir>/apps/api-server/src/$1",
      "axios": "<rootDir>/node_modules/axios/dist/node/axios.cjs",
      "sanitize-url": "<rootDir>/node_modules/@braintree/sanitize-url/dist/index.js"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
