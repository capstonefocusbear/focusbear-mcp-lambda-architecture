{
  "name": "eyst-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "prestart": "npm run migration:up",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node dist/apps/api-server/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-server/test/jest-e2e.json",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d apps/api-server/ormconfig.ts",
    "migration:generate": "npm run typeorm migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:up": "npm run typeorm -- migration:run",
    "migration:down": "npm run typeorm -- migration:revert",
    "render:deploy": "node ./.github/workflows/deploy.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.245.0",
    "@fastify/cors": "^8.2.0",
    "@fastify/helmet": "^10.1.0",
    "@fastify/static": "^6.6.0",
    "@fastify/swagger": "^8.2.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@nestjs/bull": "^0.6.2",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/common": "^9.2.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.2.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "^1.2.0",
    "@nestjs/platform-fastify": "^9.2.0",
    "@nestjs/swagger": "^6.1.3",
    "@nestjs/typeorm": "^9.0.1",
    "@nestjs/websockets": "^9.2.0",
    "@ntegral/nestjs-sentry": "^4.0.0",
    "@pusher/push-notifications-server": "^1.2.6",
    "@sendgrid/mail": "^8.1.0",
    "@sentry/node": "^7.22.0",
    "@types/html-to-text": "^9.0.0",
    "api": "^4.5.1",
    "auth0": "^4.2.0",
    "aws-sdk": "^2.1292.0",
    "axios": "^1.4.0",
    "axios-retry": "^3.6.0",
    "bull": "^4.10.2",
    "bullmq": "^5.1.0",
    "cheerio": "^1.0.0-rc.12",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.14.0",
    "fastify": "^4.10.2",
    "fastify-cors": "^6.1.0",
    "fastify-helmet": "^7.1.0",
    "fastify-multipart": "^5.4.0",
    "fastify-raw-body": "^4.0.0",
    "fastify-swagger": "^5.2.0",
    "googleapis": "^105.0.0",
    "html-to-text": "^9.0.4",
    "i18next": "^23.2.0",
    "ioredis": "^5.3.2",
    "ioredis-mock": "^8.9.0",
    "jest-mock-extended": "^3.0.5",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^2.1.2",
    "lodash": "^4.17.21",
    "luxon": "^3.1.0",
    "nestjs-i18n": "^10.2.6",
    "nestjs-pino": "^3.1.1",
    "openai": "^4.16.1",
    "pg": "^8.7.1",
    "pino-http": "^8.2.0",
    "pusher": "^5.1.0-beta",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "stream": "^0.0.2",
    "stripe": "^10.2.0",
    "typeorm": "^0.3.14",
    "typeorm-encrypted": "^0.8.0"
  },
  "devDependencies": {
    "@commitlint/config-angular": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@nestjs/cli": "^9.1.5",
    "@nestjs/schematics": "^9.0.3",
    "@nestjs/testing": "^9.2.0",
    "@types/auth0": "^2.34.19",
    "@types/bull": "^4.10.0",
    "@types/jest": "^27.0.2",
    "@types/luxon": "^3.0.2",
    "@types/node": "^16.0.0",
    "@types/pg": "^8.6.5",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.47.0",
    "@typescript-eslint/parser": "^5.47.0",
    "commitlint": "^18.4.3",
    "eslint": "^7.30.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^1.0.0-rc.13",
    "jest": "29.0.0",
    "jest-extended": "^1.0.0",
    "lint-staged": "^11.1.2",
    "pre-commit": "^1.2.2",
    "prettier": "^2.3.2",
    "supertest": "^6.1.3",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5",
    "webpack": "^5.58.2"
  },
  "overrides": {
    "fastify": "^4.10.2",
    "auth0": {
      "jsonwebtoken": "9.0.0",
      "jose": "4.15.5"
    },
    "@pusher/push-notifications-server": {
      "jsonwebtoken": "9.0.0"
    },
    "@fastify/static": {
      "send": {
        "debug": "3.1.0"
      }
    },
    "fastify-swagger": {
      "fastify-swagger-deprecated": {
        "fastify-static": {
          "fastify-static-deprecated": {
            "send": {
              "debug": "3.1.0"
            }
          }
        }
      }
    },
    "@nestjs/mapped-types": {
      "class-validator": "^0.11.1 || ^0.12.0 || ^0.13.0 || ^0.14.0"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "{apps,libs,test}/**/*.ts": [
      "npm audit --production",
      "prettier --write",
      "eslint --fix"
    ]
  },
  "jest": {
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ],
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.(t|j)s",
      "**/*.guard.(t|j)s",
      "**/*.strategy.(t|j)s",
      "**/*.middleware.(t|j)s"
    ],
    "coverageThreshold": {
      "global": {
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/",
      "<rootDir>/cron-jobs"
    ],
    "moduleNameMapper": {
      "^@app/fastify-content-types(|/.*)$": "<rootDir>/libs/fastify-content-types/src/$1",
      "^@app/crypto(|/.*)$": "<rootDir>/libs/crypto/src/$1",
      "^@app/dynamic-module(|/.*)$": "<rootDir>/libs/dynamic-module/src/$1",
      "^@app/auth0(|/.*)$": "<rootDir>/libs/auth0/src/$1",
      "^@app/pusher(|/.*)$": "<rootDir>/libs/pusher/src/$1",
      "^@app/pusher-beams(|/.*)$": "<rootDir>/libs/pusher-beams/src/$1",
      "^@app/revenue-cat(|/.*)$": "<rootDir>/libs/revenue-cat/src/$1",
      "^@app/send-grid(|/.*)$": "<rootDir>/libs/send-grid/src/$1",
      "^@app/jwt(|/.*)$": "<rootDir>/libs/jwt/src/$1",
      "^@app/stripe(|/.*)$": "<rootDir>/libs/stripe/src/$1",
      "^@app/r2(|/.*)$": "<rootDir>/libs/r2/src/$1",
      "^@app/openai(|/.*)$": "<rootDir>/libs/openai/src/$1",
      "^@app/brevo(|/.*)$": "<rootDir>/libs/brevo/src/$1",
      "axios": "<rootDir>/node_modules/axios/dist/node/axios.cjs"
    }
  }
}
