    "i18next": "^23.2.0",
    "ioredis": "^5.3.2",
    "ioredis-mock": "^8.9.0",
    "jest-mock-extended": "^4.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^2.1.2",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "mjml": "^4.17.1",
    "nestjs-i18n": "^10.5.1",
    "nestjs-pino": "^4.2.0",
    "openai": "^6.9.1",
    "pg": "^8.7.1",
